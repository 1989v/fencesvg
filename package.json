{
  "name": "fencesvg",
  "version": "0.10.1",
  "description": "Render mermaid-syntax fences as SVG that adopts your site's palette and survives your markdown sanitizer. Zero dependencies.",
  "keywords": [
    "mermaid",
    "diagram",
    "svg",
    "markdown",
    "flowchart",
    "sequence-diagram",
    "state-diagram",
    "er-diagram",
    "class-diagram",
    "dompurify",
    "ssr",
    "zero-dependency"
  ],
  "homepage": "https://github.com/1989v/fencesvg#readme",
  "bugs": {
    "url": "https://github.com/1989v/fencesvg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1989v/fencesvg.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --minify && mkdir -p docs/lib && cp dist/index.js docs/lib/",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "no-deps": "node scripts/no-deps.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "dompurify": "^3.4.14",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "sideEffects": false
}
